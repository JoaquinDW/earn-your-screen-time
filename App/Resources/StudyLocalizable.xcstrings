    "study.entry.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read something. Prove you understood it. Earn 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee algo. Demuestra que lo entendiste. Gana 15 minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies etwas. Zeig, dass du es verstanden hast. Verdien 15 Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lis quelque chose. Prouve que tu l'as compris. Gagne 15 minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi qualcosa. Dimostra di averlo capito. Guadagna 15 minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia algo. Mostre que entendeu. Ganhe 15 minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かを読む。理解したことを示す。15分を獲得。"
          }
        }
      }
    },
