    "study.camera.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a textbook page, article, printed notes, or clear handwritten notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una página, un artículo, apuntes impresos o notas manuscritas claras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze eine Buchseite, einen Artikel, gedruckte Notizen oder gut lesbare Handschrift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une page de manuel, un article, des notes imprimées ou des notes manuscrites lisibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la pagina di un libro, un articolo, appunti stampati o appunti scritti a mano ben leggibili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma página de livro, um artigo, anotações impressas ou anotações à mão bem legíveis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教科書のページ、記事、印刷したノート、読みやすい手書きのメモが使えます。"
          }
        }
      }
    },
