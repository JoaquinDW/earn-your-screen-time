    "study.intro.detail %lld": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a page or your notes. Answer one question to earn %lld minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea una página o tus apuntes. Responde una pregunta para ganar %lld minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne eine Seite oder deine Notizen. Beantworte eine Frage und verdien %lld Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne une page ou tes notes. Réponds à une question pour gagner %lld minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona una pagina o i tuoi appunti. Rispondi a una domanda per guadagnare %lld minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie uma página ou suas anotações. Responda a uma pergunta para ganhar %lld minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページやノートを読み取ります。質問に1つ答えると %lld分を獲得できます。"
          }
        }
      }
    },
    "study.intro.examples": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Textbooks, articles, printed notes, and clear handwriting work best."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionan mejor los libros, artículos, apuntes impresos y letra clara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten klappen Lehrbücher, Artikel, gedruckte Notizen und gut lesbare Handschrift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les manuels, les articles, les notes imprimées et l'écriture lisible marchent le mieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funzionano meglio libri di testo, articoli, appunti stampati e una grafia chiara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Livros, artigos, anotações impressas e letra legível funcionam melhor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教科書、記事、印刷したノート、読みやすい手書きが向いています。"
          }
        }
      }
    },
