    "study.checking.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’re checking the key idea, not spelling or writing style."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobamos la idea principal, no la ortografía ni el estilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen den Kerngedanken, nicht Rechtschreibung oder Stil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On vérifie l'idée principale, pas l'orthographe ni le style."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlliamo l'idea principale, non l'ortografia né lo stile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificamos a ideia principal, não a ortografia nem o estilo de escrita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ているのは要点で、つづりや書き方ではありません。"
          }
