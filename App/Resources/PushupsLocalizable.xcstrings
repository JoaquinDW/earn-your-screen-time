    "pushups.intro.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps are not the only way anymore. Prop your phone in front of you, do a set, and the camera counts it live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos ya no son la única vía. Apoya el móvil frente a ti, haz una serie y la cámara la cuenta en directo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte sind nicht mehr der einzige Weg. Stell dein Handy vor dich, mach eine Serie, und die Kamera zählt live mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pas ne sont plus la seule voie. Pose ton téléphone devant toi, fais une série, et la caméra la compte en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I passi non sono più l'unica strada. Appoggia il telefono davanti a te, fai una serie e la fotocamera la conta dal vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os passos já não são o único caminho. Apoie o celular na sua frente, faça uma série e a câmera conta ao vivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう歩数だけではありません。スマホを前に立てかけて1セット行えば、カメラがその場で数えます。"
          }
        }
      }
    },
