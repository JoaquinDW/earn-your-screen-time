    "pushups.intro.step.reward.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reward lands in the same balance your steps feed, up to 30 minutes a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recompensa entra en el mismo saldo que alimentan tus pasos, hasta 30 minutos al día."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Belohnung landet im selben Guthaben wie deine Schritte, bis zu 30 Minuten am Tag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récompense arrive dans le même solde que celui alimenté par tes pas, jusqu'à 30 minutes par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricompensa entra nello stesso saldo che alimentano i tuoi passi, fino a 30 minuti al giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recompensa entra no mesmo saldo que seus passos alimentam, até 30 minutos por dia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報酬は歩数と同じ残高に入ります。1日あたり最大30分です。"
          }
        }
      }
    },
