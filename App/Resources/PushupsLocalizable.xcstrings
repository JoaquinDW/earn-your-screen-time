          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está escuro demais. Acenda uma luz se puder."
          }
        }
      }
    },
    "pushups.voice.move_back" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh weiter weg, bis dein ganzer Körper ins Bild passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move back until your whole body fits in the frame."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
