    "squats.voice.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell das Handy auf, geh zurück, bis es deine Füße sieht, und steh aufrecht. Ich starte von selbst, sobald ich dich sehe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand the phone up, step back until it sees your feet, and stand tall. I'll start on my own when I can see you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoya el teléfono de pie, aléjate hasta que vea tus pies y quédate de pie. Empiezo solo cuando te vea."
          }
        },
