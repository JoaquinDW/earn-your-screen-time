    "pushups.active.camera_note": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting pauses if your body leaves the frame"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El conteo se pausa si tu cuerpo sale del encuadre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zählung pausiert, wenn dein Körper das Bild verlässt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage se met en pause si ton corps sort du cadre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio si mette in pausa se il tuo corpo esce dall'inquadratura"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem pausa se seu corpo sair do quadro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体が枠の外に出ると、カウントは一時停止します"
          }
        }
      }
    },
