    "squats.privacy.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir zählen deine Kniebeugen live auf diesem iPhone. Es werden keine Videos, Bilder oder Körperpunkte aufgezeichnet, gespeichert oder hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We count your squats live on this iPhone. No video, image, or body landmark is recorded, saved, or uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos tus sentadillas en directo en este iPhone. No se graban, guardan ni suben vídeos, imágenes o puntos corporales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous comptons tes squats en direct sur cet iPhone. Aucune vidéo, image ou repère corporel n’est enregistré, conservé ou envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiamo i tuoi squat dal vivo su questo iPhone. Nessun video, immagine o punto del corpo viene registrato, salvato o caricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクワットはこのiPhone上でリアルタイムにカウントします。動画・画像・体のポイントは記録・保存・アップロードされません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos seus agachamentos ao vivo neste iPhone. Nenhum vídeo, imagem ou ponto do corpo é gravado, salvo ou enviado."
          }
        }
      }
    },
