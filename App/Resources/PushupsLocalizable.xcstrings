    "pushups.privacy.detail": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We count your push-ups live on this iPhone. No video, image, or body landmark is recorded, saved, or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contamos tus flexiones en directo en este iPhone. No se graban, guardan ni suben vídeos, imágenes o puntos corporales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir zählen deine Liegestütze live auf diesem iPhone. Kein Video, kein Bild und kein Körperpunkt wird aufgezeichnet, gespeichert oder hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On compte tes pompes en direct sur cet iPhone. Aucune vidéo, image ou position corporelle n'est enregistrée, conservée ou envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiamo le tue flessioni dal vivo su questo iPhone. Nessun video, immagine o punto corporeo viene registrato, salvato o caricato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contamos suas flexões ao vivo neste iPhone. Nenhum vídeo, imagem ou ponto corporal é gravado, salvo ou enviado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕立て伏せはこの iPhone の中でその場で数えます。動画も画像も体の位置情報も、記録・保存・送信はしません。"
          }
        }
      }
    },
