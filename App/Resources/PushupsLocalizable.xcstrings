    "pushups.cue.arms_extended.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the top of a push-up and the set starts by itself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la posición alta de la flexión y la serie empieza sola"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die obere Liegestütz-Position, dann startet der Satz von allein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiens la position haute d'une pompe et la série démarre toute seule"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la posizione alta della flessione e la serie parte da sola"
