    "pushups.intro.step.reps.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Wiederholung zählt nur, wenn du ganz runter und wieder hoch gehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each rep is counted only when you go all the way down and back up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetición cuenta solo si bajas del todo y vuelves a subir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque répétition ne compte que si tu descends complètement et que tu remontes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni ripetizione conta solo se scendi fino in fondo e risali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかり下げて上げきったときだけ、1回としてカウントします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada repetição só conta quando você desce até o fim e volta a subir."
          }
        }
      }
    },
