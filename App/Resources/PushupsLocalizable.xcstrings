    "pushups.voice.holding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've got you. Hold still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya te veo. No te muevas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich hab dich. Nicht bewegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je t'ai. Ne bouge plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ho. Non muoverti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Te peguei. Não se mexa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見えました。そのまま動かないで。"
          }
        }
      }
    },
    "pushups.voice.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prop the phone up and get into a push-up. I'll start on my own when I can see you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya el teléfono y ponte en posición de flexión. Empiezo solo cuando te vea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell das iPhone auf und geh in die Liegestütz-Position. Ich starte von allein, sobald ich dich sehe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cale le téléphone et mets-toi en position de pompe. Je démarre tout seul dès que je te vois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia il telefono e mettiti in posizione di flessione. Parto da solo appena ti vedo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie o celular e fique na posição de flexão. Eu começo sozinho assim que te vir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を立てかけて、腕立て伏せの姿勢になってください。見えたら自動で始めます。"
          }
        }
      }
    },
    "pushups.voice.lighting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's too dark. Turn on a light if you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay muy poca luz. Enciende una luz si puedes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist zu dunkel. Mach Licht an, wenn du kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fait trop sombre. Allume une lumière si tu peux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È troppo buio. Accendi una luce se puoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está escuro demais. Acenda uma luz se puder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗すぎます。できれば明かりをつけてください。"
          }
        }
      }
    },
    "pushups.voice.move_back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move back until your whole body fits in the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aléjate hasta que todo tu cuerpo entre en el encuadre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh weiter weg, bis dein ganzer Körper ins Bild passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recule jusqu'à ce que tout ton corps tienne dans le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allontanati finché tutto il corpo non entra nell'inquadratura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afaste-se até seu corpo inteiro caber no quadro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身が枠に入るまで離れてください。"
          }
        }
      }
    },
    "pushups.voice.plank": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Straighten your body into a plank. Don't rest on your knees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estira el cuerpo en plancha. No apoyes las rodillas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streck deinen Körper zu einer geraden Plank. Nicht auf den Knien abstützen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tends ton corps en planche. Ne t'appuie pas sur les genoux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distendi il corpo in plank. Non appoggiare le ginocchia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estique o corpo em prancha. Não apoie os joelhos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体をまっすぐ伸ばしてください。ひざはつかないでください。"
          }
        }
      }
    },
    "pushups.voice.searching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't see you yet. Move so the camera sees your head, shoulders and hands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no te veo. Colócate para que la cámara vea tu cabeza, hombros y manos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich sehe dich noch nicht. Stell dich so hin, dass die Kamera Kopf, Schultern und Hände sieht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne te vois pas encore. Place-toi pour que la caméra voie ta tête, tes épaules et tes mains."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti vedo ancora. Mettiti in modo che la fotocamera veda testa, spalle e mani."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não te vejo. Se posicione para a câmera ver sua cabeça, seus ombros e suas mãos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ見えていません。カメラに頭と肩と手が入るように動いてください。"
          }
        }
      }
    },
    "pushups.voice.too_far": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're too far away. Come a bit closer to the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás demasiado lejos. Acércate un poco al teléfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist zu weit weg. Komm etwas näher ans iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es trop loin. Rapproche-toi un peu du téléphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei troppo lontano. Avvicinati un po' al telefono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está longe demais. Chegue um pouco mais perto do celular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠すぎます。iPhone に少し近づいてください。"
          }
        }
      }
    }
  },
  "version": "1.0"
}