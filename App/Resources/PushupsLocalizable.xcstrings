    "pushups.intro.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting happens on this iPhone. No video, image, or body landmark is recorded, saved, or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El conteo ocurre en este iPhone. No se graban, guardan ni suben vídeos, imágenes o puntos corporales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezählt wird auf diesem iPhone. Kein Video, kein Bild und kein Körperpunkt wird aufgezeichnet, gespeichert oder hochgeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comptage se fait sur cet iPhone. Aucune vidéo, image ou position corporelle n'est enregistrée, conservée ou envoyée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conteggio avviene su questo iPhone. Nessun video, immagine o punto corporeo viene registrato, salvato o caricato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem acontece neste iPhone. Nenhum vídeo, imagem ou ponto corporal é gravado, salvo ou enviado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントはこの iPhone の中で行われます。動画も画像も体の位置情報も、記録・保存・送信はしません。"
          }
        }
      }
    },
    "pushups.intro.step.camera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prop the phone facing you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoya el móvil de frente"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell das Handy vor dich hin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose le téléphone face à toi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appoggia il telefono rivolto verso di te"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apoie o celular virado para você"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを自分の方に向けて立てる"
          }
        }
      }
    },
    "pushups.intro.step.camera.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie framing: it only needs to see your head, shoulders, and hands. It starts on its own once it sees you set — no button to reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuadre selfie: solo necesita ver tu cabeza, hombros y manos. Empieza solo al verte en posición, sin botones que alcanzar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selfie-Perspektive: Es muss nur Kopf, Schultern und Hände sehen. Es startet von allein, sobald es dich in Position sieht – kein Knopf nötig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadrage selfie : il doit seulement voir ta tête, tes épaules et tes mains. Il démarre tout seul dès qu'il te voit en position, sans bouton à atteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inquadratura selfie: deve vedere solo testa, spalle e mani. Parte da solo appena ti vede in posizione, senza pulsanti da raggiungere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquadramento de selfie: ele só precisa ver sua cabeça, seus ombros e suas mãos. Começa sozinho assim que te vê em posição, sem botão para alcançar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自撮りの構図で、頭と肩と手が見えれば十分です。姿勢を検出すると自動で始まるので、ボタンに手を伸ばす必要はありません。"
          }
        }
      }
    },
    "pushups.intro.step.reps": {
      "extractionState": "manual",
      "localizations": {
