            "state": "translated",
            "value": "Não encontramos uma assinatura Pro ativa nesta Apple Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Apple Account で有効な Earnit Pro のサブスクリプションが見つかりませんでした。"
          }
        }
      }
    },
    "We couldn't find an active subscription for this Apple Account.": {
      "localizations": {
