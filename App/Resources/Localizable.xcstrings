    },
    "A DIFFERENT APPROACH": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "UN ENFOQUE DIFERENTE"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "EIN ANDERER ANSATZ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "UNE AUTRE APPROCHE"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "UN APPROCCIO DIVERSO"
          }
        },
        "pt-BR": {
