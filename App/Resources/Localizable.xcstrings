    "Small changes are easier to stick with. You always choose whether your goal changes.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pequeños cambios son más fáciles de mantener. Tú siempre decides si cambia tu objetivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Änderungen lassen sich leichter durchhalten. Du entscheidest immer, ob sich dein Ziel ändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les petits changements sont plus faciles à tenir. C'est toujours toi qui décides si ton objectif change."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I piccoli cambiamenti sono più facili da mantenere. Sei sempre tu a decidere se il tuo obiettivo cambia."
