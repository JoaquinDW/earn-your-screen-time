    "session.clockDisclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time starts now and keeps running when you switch apps. Return to Earnit to end the session and save the rest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo empieza ahora y sigue corriendo al cambiar de app. Vuelve a Earnit para terminar la sesión y guardar el resto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit startet jetzt und läuft weiter, wenn du die App wechselst. Komm zu Earnit zurück, um die Sitzung zu beenden und den Rest zu sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps démarre maintenant et continue même quand tu changes d'app. Reviens dans Earnit pour terminer la session et garder le reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo parte ora e continua a scorrere quando cambi app. Torna su Earnit per terminare la sessione e conservare il resto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo começa agora e continua rodando quando você troca de app. Volte ao Earnit para encerrar a sessão e guardar o resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間は今から進み、アプリを切り替えても止まりません。Earnit に戻るとセッションを終了して、残りを保存できます。"
          }
        }
      }
    },
    "session.customDuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
