    "onboarding.q.goal.sub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wrong answer — it just shapes how we talk to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay respuesta incorrecta: solo define cómo te hablamos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine falsche Antwort – sie prägt nur, wie wir mit dir sprechen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de mauvaise réponse : ça définit juste la façon dont on te parle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è una risposta sbagliata: definisce solo come ti parliamo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não existe resposta errada — isso só define como falamos com você."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正解はありません。お伝えのしかたが変わるだけです。"
          }
        }
      }
    },
    "onboarding.q.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to change?"
