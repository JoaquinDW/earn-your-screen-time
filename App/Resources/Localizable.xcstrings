    "onboarding.hook.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earnit macht Bildschirmzeit zu etwas, das du dir verdienst. Beweg dich, und die Minuten gehören dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earnit turns screen time into something you earn. Move, and the minutes are yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earnit convierte el tiempo de pantalla en algo que te ganás. Movete, y los minutos son tuyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earnit transforme le temps d'écran en quelque chose que tu gagnes. Bouge, et les minutes sont à toi."
