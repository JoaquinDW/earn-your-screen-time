    "Instead of blocking your favorite apps forever, Earnit makes screen time something you unlock by moving.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En vez de bloquear tus apps favoritas para siempre, Earnit convierte el tiempo de pantalla en algo que desbloqueas al moverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt deine Lieblings-Apps für immer zu sperren, macht Earnit Bildschirmzeit zu etwas, das du dir durch Bewegung freischaltest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lieu de bloquer tes apps préférées pour toujours, Earnit fait du temps d'écran quelque chose que tu débloques en bougeant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invece di bloccare per sempre le tue app preferite, Earnit rende il tempo di schermo qualcosa che sblocchi muovendoti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em vez de bloquear seus apps favoritos para sempre, o Earnit transforma o tempo de tela em algo que você desbloqueia se movendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りのアプリをずっとブロックするのではなく、Earnit はスクリーンタイムを、体を動かして解除するものに変えます。"
          }
        }
      }
    },
