    "Subscription renews automatically unless canceled at least 24 hours before the end of the current period. Manage or cancel in App Store settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Abo verlängert sich automatisch, sofern du nicht mindestens 24 Stunden vor Ende des laufenden Zeitraums kündigst. Du kannst es in den App Store Einstellungen verwalten oder kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente salvo que la canceles al menos 24 horas antes de que termine el periodo actual. Puedes gestionarla o cancelarla en los ajustes del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abonnement se renouvelle automatiquement sauf si tu l’annules au moins 24 heures avant la fin de la période en cours. Tu peux le gérer ou l’annuler dans les réglages de l’App Store."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’abbonamento si rinnova automaticamente a meno che tu non lo annulli almeno 24 ore prima della fine del periodo in corso. Puoi gestirlo o annullarlo nelle impostazioni di App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の期間が終了する24時間前までに解約しない場合、サブスクリプションは自動更新されます。App Storeの設定で管理または解約できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A assinatura é renovada automaticamente, a menos que você cancele pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele nos ajustes da App Store."
          }
        }
      }
    },
