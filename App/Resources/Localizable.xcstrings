            "state": "translated",
            "value": "そこから始めましょう。"
          }
        }
      }
    },
    "We'll start with %@ and suggest small changes only when you're ready.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezaremos con %@ y solo sugeriremos pequeños cambios cuando estés listo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir starten mit %@ und schlagen kleine Änderungen erst vor, wenn du bereit bist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On commencera avec %@ et on ne proposera de petits changements que quand tu seras prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Partiremo da %@ e ti proporremo piccoli cambiamenti solo quando sarai pronto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos começar com %@ e só sugerir pequenas mudanças quando você estiver pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から始めて、準備ができたときだけ小さな変更をおすすめします。"
          }
        }
      }
    },
