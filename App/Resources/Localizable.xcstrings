    "Take a short walk. Open Earnit when you return and your first reward will be waiting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh eine kurze Runde. Öffne Earnit, wenn du zurück bist, und deine erste Belohnung wartet schon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da un paseo corto. Abre Earnit cuando vuelvas y tu primera recompensa te estará esperando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais une petite marche. Ouvre Earnit à ton retour et ta première récompense t'attendra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai una breve camminata. Apri Earnit quando torni e la tua prima ricompensa ti starà aspettando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少し歩いてみてください。戻って Earnit を開くと、最初の報酬が待っています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê uma caminhada curta. Abra o Earnit quando voltar e sua primeira recompensa vai estar esperando."
          }
        }
      }
    },
    "Tap Try again. If it keeps failing, restart your iPhone and come back — your answers are saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf Erneut versuchen. Wenn es weiter fehlschlägt, starte dein iPhone neu und komm zurück – deine Antworten sind gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Intentar de nuevo. Si sigue fallando, reinicia tu iPhone y vuelve: tus respuestas están guardadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touche Réessayer. Si ça échoue encore, redémarre ton iPhone et reviens : tes réponses sont enregistrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Riprova. Se continua a non funzionare, riavvia l'iPhone e torna qui: le tue risposte sono salvate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「もう一度試す」をタップしてください。失敗が続く場合はiPhoneを再起動して戻ってきてください。回答は保存されています。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Tentar de novo. Se continuar falhando, reinicie o iPhone e volte — suas respostas estão salvas."
          }
        }
      }
    },
