        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua stima definisce l’obiettivo. Collega Apple Health più tardi per guadagnare tempo camminando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
