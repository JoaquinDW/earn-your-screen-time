    "That can add up to about %lld hours each week. Earnit helps you make that time more intentional." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das können etwa %lld Stunden pro Woche werden. Earnit hilft dir, diese Zeit bewusster zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso puede sumar unas %lld horas cada semana. Earnit te ayuda a usar ese tiempo de forma más consciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça peut représenter environ %lld heures chaque semaine. Earnit t'aide à rendre ce temps plus intentionnel."
