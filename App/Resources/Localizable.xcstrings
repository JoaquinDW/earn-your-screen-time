    "Protected apps stay paused until you deliberately start a 5, 10, or 15-minute session with the balance you've earned." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschützte Apps bleiben pausiert, bis du bewusst eine Sitzung von 5, 10 oder 15 Minuten mit deinem verdienten Guthaben startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps protegidas permanecen en pausa hasta que inicias deliberadamente una sesión de 5, 10 o 15 minutos con el saldo que ganaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps protégées restent en pause jusqu'à ce que tu lances délibérément une session de 5, 10 ou 15 minutes avec le solde que tu as gagné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app protette restano in pausa finché non avvii deliberatamente una sessione di 5, 10 o 15 minuti con il saldo che ti sei guadagnato."
