          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne va pas te demander d'abandonner les apps que tu aimes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ti chiederemo di lasciare le app che ti piacciono."
