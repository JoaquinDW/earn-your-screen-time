        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn Your Screen Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganá tu tiempo de pantalla"
          }
        }
      }
    },
    "onboarding.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move first. Scroll later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Moverte primero. Scrollear después."
          }
        }
      }
    },
    "onboarding.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the apps you want to control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegí las apps que querés controlar."
          }
        }
      }
    },
    "onboarding.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk to earn screen time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminá para ganar tiempo de pantalla."
          }
        }
      }
    },
    "onboarding.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend those minutes on your apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastá esos minutos en tus apps."
          }
        }
      }
    },
    "onboarding.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your balance hits zero, they lock again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el saldo llega a cero, se bloquean otra vez."
          }
        }
      }
    },
