    "onboarding.screenTimeRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time access is required for blocking to work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Tiempo de uso es necesario para que el bloqueo funcione."
          }
        }
      }
    },
    "onboarding.permissions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two permissions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos permisos"
          }
        }
      }
    },
    "onboarding.permissions.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on your iPhone. Nothing is uploaded anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo queda en tu iPhone. No se sube nada a ningún lado."
          }
        }
      }
    },
    "onboarding.permission.screenTime.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de uso"
          }
        }
      }
    },
    "onboarding.permission.screenTime.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the app block and unblock the apps you choose. Without it, nothing can be blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite bloquear y desbloquear las apps que elijas. Sin esto no se puede bloquear nada."
          }
        }
      }
    },
    "onboarding.permission.screenTime.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Screen Time access, blocking cannot work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a Tiempo de uso el bloqueo no puede funcionar."
          }
        }
      }
    },
    "onboarding.permission.health.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasos"
          }
        }
      }
    },
    "onboarding.permission.health.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your daily step count so walking earns you minutes. Your health data never leaves the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee tus pasos del día para que caminar te dé minutos. Tus datos de salud nunca salen del dispositivo."
          }
        }
      }
    },
    "onboarding.permission.health.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without step access, walking cannot earn screen time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a los pasos, caminar no puede generar tiempo de pantalla."
          }
        }
      }
    },
