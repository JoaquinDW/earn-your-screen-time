    "Your goal and earn rate are separate. Start with our recommended earn rate and change it later from Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziel und Verdienrate sind zwei Dinge. Starte mit unserer empfohlenen Verdienrate und ändere sie später in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu objetivo y tu ritmo de ganancia son independientes. Empieza con el ritmo recomendado y cámbialo más adelante en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton objectif et ton taux de gain sont indépendants. Commence avec le taux recommandé et change-le plus tard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo obiettivo e il tuo ritmo di guadagno sono indipendenti. Inizia con il ritmo consigliato e cambialo più avanti in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
