    "A 2022 meta-analysis of 15 international studies found that health benefits were associated with step counts below 10,000, and the pattern differed by age.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un metaanálisis de 2022 de 15 estudios internacionales encontró beneficios para la salud asociados con cifras inferiores a 10.000 pasos, con diferencias según la edad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Metaanalyse von 2022 mit 15 internationalen Studien fand Gesundheitsvorteile schon bei Schrittzahlen unter 10.000 – mit Unterschieden je nach Alter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une méta-analyse de 2022 portant sur 15 études internationales a associé des bénéfices pour la santé à des nombres de pas inférieurs à 10 000, avec des différences selon l'âge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una meta-analisi del 2022 su 15 studi internazionali ha rilevato benefici per la salute associati a conteggi di passi inferiori a 10.000, con differenze in base all'età."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma metanálise de 2022 com 15 estudos internacionais encontrou benefícios para a saúde associados a contagens abaixo de 10.000 passos, com padrões diferentes conforme a idade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2022年の国際的な15件の研究のメタ分析では、10,000歩未満でも健康上のメリットが見られ、その傾向は年齢によって異なりました。"
          }
        }
      }
    },
    "A blocking app": {
      "localizations": {
        "es": {
