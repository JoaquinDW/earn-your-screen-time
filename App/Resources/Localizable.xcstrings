    "settings.rule.changeWarning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new rule applies from now on. Steps you already earned credit for are not counted again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La regla nueva se aplica a partir de ahora. Los pasos que ya te dieron crédito no se cuentan de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Regel gilt ab jetzt. Schritte, für die du bereits Guthaben bekommen hast, werden nicht erneut gezählt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
