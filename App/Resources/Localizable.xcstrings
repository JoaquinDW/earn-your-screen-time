          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova regola vale da ora in poi. I passi per cui hai già ricevuto minuti non vengono contati di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova regra vale a partir de agora. Os passos que já renderam crédito não são contados de novo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいルールはこれ以降に適用されます。すでに分に換算した歩数は二重に数えません。"
          }
        }
      }
