    "Your estimate gives us everything needed to begin. Your plan will update from your real steps." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Schätzung reicht uns zum Start. Dein Plan passt sich an deine echten Schritte an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu estimación nos basta para empezar. Tu plan se actualizará con tus pasos reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton estimation nous suffit pour commencer. Ton plan se mettra à jour avec tes vrais pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua stima ci basta per iniziare. Il tuo piano si aggiornerà con i tuoi passi reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始めるには推定値で十分です。プランは実際の歩数に合わせて更新されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua estimativa já nos dá tudo o que precisamos para começar. Seu plano vai se atualizar com seus passos reais."
          }
        }
      }
    },
    "Your estimate sets your goal. Connect Apple Health later to earn from walking." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Schätzung legt dein Ziel fest. Verbinde später Apple Health, um durchs Gehen Zeit zu verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your estimate sets your goal. Connect Apple Health later to earn from walking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu estimación define tu meta. Conecta Apple Health más tarde para ganar tiempo caminando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre estimation définit votre objectif. Connectez Apple Health plus tard pour gagner du temps en marchant."
