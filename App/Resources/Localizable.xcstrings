    "earn.footnote %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuten landen unterwegs in deinem Guthaben. Bis zu %lld gehen über Mitternacht hinaus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutes land in your balance as you go. Up to %lld carry over past midnight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los minutos entran en tu saldo sobre la marcha. Hasta %lld pasan de la medianoche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minutes arrivent dans ton solde au fur et à mesure. Jusqu'à %lld sont reportées après minuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
