        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme le mouvement du quotidien en temps pour les apps que tu aimes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma il movimento di ogni giorno in tempo per le app che ami."
