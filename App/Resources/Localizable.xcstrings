        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua estimativa define a meta. Conecte o Apple Health depois para ganhar tempo caminhando."
          }
        }
      }
    },
    "Your estimate sets your goal. Connect Apple Health on the Earn screen to count your steps." : {
