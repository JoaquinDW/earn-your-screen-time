    "Your subscription automatically renews for %@ %@ unless canceled at least 24 hours before the end of the current period. Manage or cancel anytime in App Store settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción se renueva automáticamente por %1$@ %2$@, salvo que la canceles al menos 24 horas antes de que termine el periodo actual. Puedes gestionarla o cancelarla en cualquier momento en los ajustes del App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo verlängert sich automatisch für %1$@ %2$@, sofern du nicht mindestens 24 Stunden vor Ende des laufenden Zeitraums kündigst. Du kannst es jederzeit in den App Store Einstellungen verwalten oder kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton abonnement se renouvelle automatiquement à %1$@ %2$@, sauf si tu l'annules au moins 24 heures avant la fin de la période en cours. Tu peux le gérer ou l'annuler à tout moment dans les réglages de l'App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo abbonamento si rinnova automaticamente a %1$@ %2$@, a meno che tu non lo annulli almeno 24 ore prima della fine del periodo in corso. Puoi gestirlo o annullarlo quando vuoi nelle impostazioni di App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura é renovada automaticamente por %1$@ %2$@, a menos que você cancele pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele quando quiser nos ajustes da App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の期間が終わる24時間前までに解約しない場合、サブスクリプションは %1$@ %2$@ で自動更新されます。App Store の設定でいつでも管理・解約できます。"
          }
        }
      }
    },
    "Your walking rhythm is getting stronger.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ritmo al caminar está mejorando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Geh-Rhythmus wird stärker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton rythme de marche s'affermit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ritmo di cammino sta migliorando."
          }
        },
        "pt-BR": {
          "stringUnit": {
