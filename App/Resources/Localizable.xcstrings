    "We can use your recent walking activity to suggest a more achievable daily goal. Your earn rate and existing balance will not change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos usar tu actividad reciente al caminar para sugerir un objetivo diario más alcanzable. Tu ritmo de ganancia y tu saldo actual no cambiarán."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir können deine jüngste Geh-Aktivität nutzen, um dir ein besser erreichbares Tagesziel vorzuschlagen. Deine Verdienrate und dein Guthaben ändern sich nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On peut utiliser ton activité de marche récente pour te proposer un objectif quotidien plus atteignable. Ton taux de gain et ton solde actuel ne changeront pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possiamo usare la tua attività di cammino recente per suggerirti un obiettivo giornaliero più raggiungibile. Il tuo ritmo di guadagno e il saldo attuale non cambieranno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Podemos usar sua atividade recente de caminhada para sugerir uma meta diária mais alcançável. Seu ritmo de ganho e seu saldo atual não mudam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の歩行データをもとに、より達成しやすい1日の目標を提案できます。獲得レートと今の残高は変わりません。"
          }
        }
      }
    },
    "We couldn't find an active Pro subscription for this Apple Account.": {
      "comment": "An alert message displayed when a user tries to restore purchases but doesn't have an active Pro subscription.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos una suscripción Pro activa para esta cuenta de Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben kein aktives Pro-Abo für diesen Apple Account gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas trouvé d'abonnement Pro actif pour cet Apple Account."
          }
        },
        "it": {
