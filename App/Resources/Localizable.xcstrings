          }
        }
      }
    },
    "We couldn't find enough recent walking data. Your current setup stays exactly as it is.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos suficientes datos recientes de caminatas. Tu configuración actual se mantiene exactamente igual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben nicht genug aktuelle Gehdaten gefunden. Deine Einstellungen bleiben genau so, wie sie sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas trouvé assez de données de marche récentes. Ta configuration actuelle reste exactement la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato abbastanza dati recenti sulle tue camminate. La tua configurazione attuale resta esattamente com'è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos dados recentes de caminhada suficientes. Sua configuração atual fica exatamente como está."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の歩行データが十分に見つかりませんでした。今の設定はそのままです。"
          }
        }
      }
    },
    "We couldn't find enough walking history. A quick estimate works too.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No encontramos suficiente historial de caminatas. Una estimación rápida también sirve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben nicht genug Gehverlauf gefunden. Eine schnelle Schätzung reicht auch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas trouvé assez d'historique de marche. Une estimation rapide fait aussi l'affaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non abbiamo trovato abbastanza cronologia delle camminate. Va bene anche una stima veloce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não encontramos histórico de caminhada suficiente. Uma estimativa rápida também serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩行の履歴が十分に見つかりませんでした。ざっくりした推定でも大丈夫です。"
          }
        }
      }
    },
    "We'll start from there.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezaremos desde ahí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von da aus starten wir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On partira de là."
          }
        },
        "it": {
