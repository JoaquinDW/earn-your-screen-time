    "In a hurry? A set of push-ups in front of the camera earns minutes right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a hurry? A set of push-ups in front of the camera earns minutes right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con prisa? Una serie de flexiones frente a la cámara te da minutos ahora mismo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenig Zeit? Eine Serie Liegestütze vor der Kamera bringt dir sofort Minuten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressé ? Une série de pompes devant la caméra te rapporte des minutes tout de suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fretta? Una serie di flessioni davanti alla fotocamera ti fa guadagnare minuti subito."
          }
        },
        "pt-BR": {
          "stringUnit": {
