    "appSelection.removal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes we change the plan just to resolve the impulse of the moment. Pause for a second before deciding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces cambiamos el plan solo para resolver el impulso del momento. Detente un segundo antes de decidir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manchmal ändern wir den Plan nur, um den Impuls des Moments loszuwerden. Halte kurz inne, bevor du entscheidest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois, on change le plan juste pour céder à l'impulsion du moment. Prends une seconde avant de décider."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A volte cambiamo il piano solo per risolvere l'impulso del momento. Fermati un secondo prima di decidere."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Às vezes mudamos o plano só para resolver o impulso do momento. Pare um segundo antes de decidir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場の衝動を解消するためだけに、計画を変えてしまうことがあります。決める前に少し立ち止まってみましょう。"
          }
        }
      }
    },
    "appSelection.removal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you trying to bypass your own block?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás intentando saltarte tu propio bloqueo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willst du gerade deine eigene Sperre umgehen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu essaies de contourner ton propre blocage ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai cercando di aggirare il tuo stesso blocco?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está tentando burlar seu próprio bloqueio?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で決めたブロックを外そうとしていませんか？"
          }
        }
