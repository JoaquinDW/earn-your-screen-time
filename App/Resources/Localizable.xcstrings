    "appSelection.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is blocked yet. Choose the apps whose minutes should come out of your balance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada bloqueado. Elige las apps cuyos minutos saldrán de tu saldo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ist nichts blockiert. Wähle die Apps, deren Minuten von deinem Guthaben abgehen sollen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore bloqué. Choisis les apps dont les minutes seront déduites de ton solde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora niente di bloccato. Scegli le app i cui minuti usciranno dal tuo saldo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está bloqueado ainda. Escolha os apps cujos minutos vão sair do seu saldo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もブロックされていません。残高から分を使うアプリを選びましょう。"
          }
        }
      }
    },
    "appSelection.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only these spend your minutes. Everything else on your phone is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo estas gastan tus minutos. Todo lo demás en tu teléfono queda igual."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diese verbrauchen deine Minuten. Alles andere auf deinem iPhone bleibt unberührt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules ces apps dépensent tes minutes. Tout le reste de ton téléphone reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo queste consumano i tuoi minuti. Tutto il resto sul telefono resta com'è."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só esses gastam seus minutos. Todo o resto do seu celular fica intacto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分を使うのはここで選んだアプリだけです。ほかのアプリはそのままです。"
          }
        }
      }
    },
    "appSelection.needsAuthorization": {
      "extractionState": "manual",
      "localizations": {
