    "onboarding.hook.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit turns screen time into something you earn. Walk, and the minutes are yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit convierte el tiempo de pantalla en algo que te ganas. Camina, y los minutos son tuyos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit macht Bildschirmzeit zu etwas, das du dir verdienst. Geh los, und die Minuten gehören dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit transforme le temps d'écran en quelque chose que tu gagnes. Marche, et les minutes sont à toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit trasforma il tempo di schermo in qualcosa che ti guadagni. Cammina, e i minuti sono tuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Earnit transforma o tempo de tela em algo que você ganha. Caminhe, e os minutos são seus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit はスクリーンタイムを、自分で獲得するものに変えます。歩けば、その分はあなたのものです。"
          }
        }
      }
    },
