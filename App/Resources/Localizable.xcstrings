    "An estimate based on the range you selected. The point isn't guilt. It's seeing what autopilot can cost.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una estimación basada en el rango que elegiste. No se trata de sentir culpa, sino de ver cuánto puede costar el piloto automático."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schätzung auf Basis des von dir gewählten Bereichs. Es geht nicht um Schuld, sondern darum zu sehen, was Autopilot kosten kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation basée sur la fourchette que tu as choisie. L'idée n'est pas de culpabiliser, mais de voir ce que le pilote automatique peut coûter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È una stima basata sull'intervallo che hai scelto. Non si tratta di sentirsi in colpa, ma di vedere quanto può costare il pilota automatico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É uma estimativa baseada na faixa que você escolheu. A ideia não é culpa, é ver quanto o piloto automático pode custar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ範囲をもとにした推定です。罪悪感を持つためではなく、無意識の習慣にかかる代償を知るためのものです。"
          }
        }
      }
    },
    "An estimate is enough. You can adjust your plan later.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación es suficiente. Puedes ajustar tu plan más adelante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Schätzung reicht. Du kannst deinen Plan später anpassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation suffit. Tu pourras ajuster ton plan plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima basta. Puoi modificare il tuo piano più avanti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa já basta. Você pode ajustar seu plano depois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "だいたいで大丈夫です。プランは後から調整できます。"
          }
        }
      }
    },
    "Any amount of physical activity is better than none.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier cantidad de actividad física es mejor que ninguna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Menge an Bewegung ist besser als gar keine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu d'activité physique vaut toujours mieux que pas du tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi quantità di attività fisica è meglio di niente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer quantidade de atividade física é melhor do que nenhuma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どんなに少しでも、体を動かすことは何もしないより良いです。"
          }
        }
      }
    },
