    "The evidence supports moving more and sitting less. It does not guarantee a specific health outcome for any individual." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Belege sprechen für mehr Bewegung und weniger Sitzen. Ein bestimmtes Gesundheitsergebnis garantieren sie niemandem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La evidencia respalda moverse más y pasar menos tiempo sentado. No garantiza un resultado de salud específico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données appuient le fait de bouger plus et de rester moins assis. Elles ne garantissent aucun résultat de santé particulier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le evidenze sostengono che muoversi di più e stare meno seduti fa bene. Non garantiscono un risultato di salute specifico per nessuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "研究が支持しているのは、もっと動き、座る時間を減らすことです。個人ごとの健康効果を保証するものではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A evidência apoia se mover mais e ficar menos sentado. Ela não garante um resultado de saúde específico para ninguém."
          }
        }
      }
    },
    "The goal only changes after a full week, and only if you accept." : {
      "localizations" : {
