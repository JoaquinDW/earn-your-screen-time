    "session.active.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clock keeps running until this session ends or you end it early."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj sigue corriendo hasta que termine la sesión o la finalices antes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr läuft weiter, bis diese Sitzung endet oder du sie früher beendest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chrono continue jusqu'à la fin de la session ou jusqu'à ce que tu y mettes fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio continua a correre finché la sessione non finisce o non la chiudi prima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio continua rodando até esta sessão acabar ou você encerrá-la antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションが終わるか、自分で終了するまで時計は進み続けます。"
          }
        }
      }
    },
