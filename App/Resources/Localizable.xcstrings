          }
        }
      }
    },
    "Not a ban. A pause you can open, once you've moved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Verbot. Eine Pause, die sich öffnet, sobald du dich bewegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una prohibición. Es una pausa que se abre cuando te movés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas une interdiction. Une pause qui s'ouvre dès que tu bouges."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è un divieto. È una pausa che si apre quando ti muovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁止ではありません。動けば開く、ひと呼吸です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é uma proibição. É uma pausa que abre quando você se move."
          }
        }
      }
    },
    "Not a permanent ban. Not another limit to ignore. A pause between impulse and choice." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein permanentes Verbot. Kein weiteres Limit zum Ignorieren. Eine Pause zwischen Impuls und Entscheidung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una prohibición permanente. Tampoco otro límite que ignorar. Es una pausa entre el impulso y la elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas une interdiction définitive. Ni une limite de plus à ignorer. C'est une pause entre l'impulsion et le choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è un divieto permanente. Non è un altro limite da ignorare. È una pausa tra l'impulso e la scelta."
          }
