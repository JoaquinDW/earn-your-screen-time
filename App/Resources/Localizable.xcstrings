    "An estimate based on the range you selected. The point isn't guilt. It's seeing what autopilot can cost." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Schätzung auf Basis des von dir gewählten Bereichs. Es geht nicht um Schuld, sondern darum zu sehen, was Autopilot kosten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una estimación basada en el rango que elegiste. No se trata de sentir culpa, sino de ver cuánto puede costar el piloto automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une estimation basée sur la fourchette que tu as choisie. L'idée n'est pas de culpabiliser, mais de voir ce que le pilote automatique peut coûter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È una stima basata sull'intervallo che hai scelto. Non si tratta di sentirsi in colpa, ma di vedere quanto può costare il pilota automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ範囲をもとにした推定です。罪悪感を持つためではなく、無意識の習慣にかかる代償を知るためのものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
