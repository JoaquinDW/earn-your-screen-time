    "Your app activity stays private. Earnit only stores Apple’s opaque selections on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app activity stays private. Earnit only stores Apple’s opaque selections on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu actividad en las apps sigue siendo privada. Earnit solo guarda las selecciones opacas de Apple en este dispositivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine App-Nutzung bleibt privat. Earnit speichert nur Apples anonyme Auswahl auf diesem Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton activité dans les apps reste privée. Earnit ne conserve que les sélections opaques d'Apple sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua attività nelle app resta privata. Earnit conserva solo le selezioni opache di Apple su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua atividade nos apps continua privada. O Earnit só guarda as seleções opacas da Apple neste dispositivo."
