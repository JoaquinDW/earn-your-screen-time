    "We couldn't find enough recent walking data. Your current setup stays exactly as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben nicht genug aktuelle Gehdaten gefunden. Deine Einstellungen bleiben genau so, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos suficientes datos recientes de caminatas. Tu configuración actual se mantiene exactamente igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n'avons pas trouvé assez de données de marche récentes. Ta configuration actuelle reste exactement la même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
