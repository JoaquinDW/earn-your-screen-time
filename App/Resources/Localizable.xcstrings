    "Your goal and earn rate are separate. Start with our recommended earn rate and change it later from Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo y tu ritmo de ganancia son independientes. Empieza con el ritmo recomendado y cámbialo más adelante en Ajustes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel und Verdienrate sind zwei Dinge. Starte mit unserer empfohlenen Verdienrate und ändere sie später in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton objectif et ton taux de gain sont indépendants. Commence avec le taux recommandé et change-le plus tard dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo obiettivo e il tuo ritmo di guadagno sono indipendenti. Inizia con il ritmo consigliato e cambialo più avanti in Impostazioni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua meta e seu ritmo de ganho são independentes. Comece com o ritmo recomendado e mude depois nos Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標と獲得レートは別のものです。まずはおすすめの獲得レートで始めて、あとから設定で変更できます。"
          }
        }
      }
    },
    "Your goal tracks daily progress. It does not change how quickly you earn minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo registra el progreso diario. No cambia la rapidez con la que ganas minutos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ziel misst den täglichen Fortschritt. Es ändert nicht, wie schnell du Minuten verdienst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton objectif suit ta progression quotidienne. Il ne change pas la vitesse à laquelle tu gagnes des minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo obiettivo registra i progressi giornalieri. Non cambia la velocità con cui guadagni minuti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua meta acompanha o progresso diário. Ela não muda a velocidade com que você ganha minutos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標は毎日の進み具合を記録するものです。分を獲得する速さは変わりません。"
          }
        }
      }
    },
    "Your health history stays on your device. Earnit only keeps the baseline used for your plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu historial de salud permanece en tu dispositivo. Earnit solo guarda el punto de partida usado para tu plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gesundheitsverlauf bleibt auf deinem Gerät. Earnit behält nur den Ausgangswert für deinen Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton historique de santé reste sur ton appareil. Earnit ne conserve que le point de départ utilisé pour ton plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cronologia di salute resta sul tuo dispositivo. Earnit conserva solo il punto di partenza usato per il tuo piano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu histórico de saúde fica no seu dispositivo. O Earnit só guarda o ponto de partida usado no seu plano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康の履歴は端末内に残ります。Earnit が保存するのは、プランに使う出発点だけです。"
