    "paywall.plan.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A coffee lasts minutes. A habit can change your days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un café dura unos minutos. Un hábito puede cambiar tus días."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kaffee dauert Minuten. Eine Gewohnheit kann deine Tage verändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un café dure quelques minutes. Une habitude peut changer tes journées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un caffè dura pochi minuti. Un'abitudine può cambiarti le giornate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um café dura minutos. Um hábito pode mudar seus dias."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーヒーは数分で終わります。習慣は毎日を変えます。"
          }
        }
      }
    },
    "paywall.plan.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the price of one coffee a month, Earnit helps you move more, reclaim time, and use your apps intentionally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por el precio de un café al mes, Earnit te ayuda a moverte más, recuperar tiempo y usar tus apps con intención."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Preis eines Kaffees im Monat hilft dir Earnit, dich mehr zu bewegen, Zeit zurückzugewinnen und deine Apps bewusst zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le prix d'un café par mois, Earnit t'aide à bouger plus, à récupérer du temps et à utiliser tes apps de façon intentionnelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al prezzo di un caffè al mese, Earnit ti aiuta a muoverti di più, a recuperare tempo e a usare le tue app con intenzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo preço de um café por mês, o Earnit te ajuda a se mover mais, recuperar tempo e usar seus apps com intenção."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月にコーヒー1杯の値段で、Earnit がもっと動き、時間を取り戻し、アプリを意識して使えるよう手助けします。"
          }
        }
      }
    },
    "paywall.subtitle": {
      "extractionState": "manual",
      "localizations": {
