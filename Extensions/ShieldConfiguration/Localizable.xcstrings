        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine %lld Min. starten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer mes %lld min"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia i miei %lld min"
