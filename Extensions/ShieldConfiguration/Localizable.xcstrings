    "shield.noTime.progress": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do pushups in Earnit now, or walk %1$lld more steps for %2$lld min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz flexiones en Earnit ahora, o camina %1$lld pasos más para ganar %2$lld min."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach jetzt Liegestütze in Earnit oder geh noch %1$lld Schritte für %2$lld Min."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais des pompes dans Earnit, ou marche encore %1$lld pas pour gagner %2$lld min."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai flessioni in Earnit, oppure cammina altri %1$lld passi per guadagnare %2$lld min."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça flexões no Earnit ou caminhe mais %1$lld passos para ganhar %2$lld min."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit で腕立て伏せ、またはあと %1$lld 歩で %2$lld 分を獲得。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 Earnit에서 팔굽혀펴기를 하거나, %1$lld걸음 더 걸어 %2$lld분을 벌어요."
          }
        }
      }
    },
    "shield.noTime.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Earnit for pushups, or walk to earn time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Earnit para hacer flexiones, o camina para ganar tiempo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Earnit für Liegestütze oder geh, um Zeit zu verdienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Earnit pour faire des pompes, ou marche pour gagner du temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Earnit per fare flessioni, oppure cammina per guadagnare tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Earnit para fazer flexões ou caminhe para ganhar tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit で腕立て伏せをするか、歩いて時間を稼ぎましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Earnit에서 팔굽혀펴기를 하거나 걸어서 시간을 벌어요."
          }
        }
      }
    },
