        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur noch %lld Schritte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus que %lld pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano solo %lld passi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam só %lld passos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと %lld 歩です。"
          }
        }
      }
    },
    "shield.available.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a session. The rest stays yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una sesión. El resto sigue siendo tuyo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Sitzung. Der Rest bleibt dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis une session. Le reste t'appartient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una sessione. Il resto resta tuo."
