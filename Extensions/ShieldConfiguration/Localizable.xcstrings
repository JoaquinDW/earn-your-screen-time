    "shield.action.useMinutes": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start my %lld min"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar mis %lld min"
