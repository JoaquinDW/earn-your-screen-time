    "shield.expired.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk toward %lld steps to earn more. Your apps are paused for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Camina hasta %lld pasos para ganar más. Tus apps están en pausa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geh in Richtung %lld Schritte, um mehr zu verdienen. Deine Apps sind vorerst pausiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche vers %lld pas pour en gagner plus. Tes apps sont en pause pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cammina verso %lld passi per guadagnarne altri. Le tue app sono in pausa per ora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhe até %lld passos para ganhar mais. Seus apps estão pausados por enquanto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 歩を目指して歩くと、もっと稼げます。アプリは今は止まっています。"
          }
        }
      }
    },
