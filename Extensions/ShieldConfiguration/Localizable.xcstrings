    "shield.almost.subtitle": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About a %2$lld min walk from earning your next %1$lld min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A unos %2$lld min caminando de ganar tus próximos %1$lld min."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %2$lld Min. Gehen bis zu deinen nächsten %1$lld Min."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À environ %2$lld min de marche de tes prochaines %1$lld min."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A circa %2$lld min di cammino dai tuoi prossimi %1$lld min."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A uns %2$lld min de caminhada dos seus próximos %1$lld min."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の %1$lld 分まで、歩いておよそ %2$lld 分です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %2$lld분 더 걸으면 다음 %1$lld분을 벌어요."
          }
        }
      }
    },
