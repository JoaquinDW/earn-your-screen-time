    "shield.action.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now, I'll pass"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no, paso"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt nicht, ich verzichte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas maintenant, je passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ora, passo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora não, vou passar"
          }
        },
