        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir cuánto tiempo"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit wählen"
          }
        },
        "fr": {
