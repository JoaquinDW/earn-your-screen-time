# Supabase supplies its URL and API keys automatically in hosted functions.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini-2024-07-18

REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-hmac-signing-secret
REVENUECAT_SECRET_API_KEY=replace-with-revenuecat-secret-v1-key
REVENUECAT_ENTITLEMENT_ID=Earn your Screen Time Pro
REVENUECAT_CACHE_SECONDS=300

# Optional: pushes for Friends (nudges, cheers, missed goals). Without them nothing is pushed and
# friends see everything in the app's inbox. The key is the .p8 from Certificates, Identifiers &
# Profiles > Keys; paste it with literal \n line breaks.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.balthasardeweert.earnyourscreentime
